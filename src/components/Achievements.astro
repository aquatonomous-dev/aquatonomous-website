---
import { latestAchievements } from "@utils/achievements.js";
---

<section class="pb-8 md:pb-24">
  <div class="mx-auto max-w-5xl">
    <header class="text-center">
      <h2 class="text-4xl font-bold text-AquaNavy lg:text-5xl lg:tracking-tight">
        Latest Achievements.
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        The newest additions to our record are highlighted here. Visit the full
        achievements page for our broader milestones and awards.
      </p>
    </header>

    <div class="mt-12 grid gap-10 rounded-xl border-2 border-dashed border-slate-300 p-8 md:grid-cols-2">
      {latestAchievements.map((item) => (
        <div class="flex items-start gap-4">
          <div class="text-2xl" aria-hidden="true">{item.emoji}</div>
          <div>
            <h3 class="text-lg font-semibold text-AquaNavy">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-slate-500">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href="/achievements"
        class="inline-flex items-center rounded-xl bg-AquaNavy px-6 py-3 text-sm font-medium text-white shadow-lg transition-all duration-200 hover:bg-AquaBlue"
      >
        View All Achievements
      </a>
    </div>
  </div>
</section>
