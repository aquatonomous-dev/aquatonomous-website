---
interface Props {
  size?: "sm" | "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "cta";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-5 py-2.5",
  lg: "px-6 py-3",
};

const styles = {
  outline: "border-2 border-black hover:bg-black text-black hover:text-white",
  primary:
    "bg-AquaNavy text-white hover:bg-slate-700 border-2 border-transparent",
  inverted: "bg-white text-black hover:bg-gray-100 border-2 border-transparent",
  cta: "bg-AquaNavy text-white hover:bg-AquaBlue/80 border-2 border-transparent rounded-md font-medium shadow-md",
};
---

<button
  {...rest}
  class:list={[
    "rounded text-center transition focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
