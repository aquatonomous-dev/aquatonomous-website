<div class="relative h-screen w-full overflow-hidden">

  <!-- Background Video (shown on medium and up) -->
  <div class="absolute inset-0 z-0 pointer-events-none hidden sm:block">
    <video
      class="h-full w-full object-cover"
      poster="/videos/hero-broll-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    >
      <!-- media keeps phones, which show the image below, from downloading the video -->
      <source src="/videos/hero-broll.mp4" type="video/mp4" media="(min-width: 640px)" />
    </video>
  </div>

  <!-- Fallback Background Image (shown on small screens) -->
  <div class="absolute inset-0 z-0 pointer-events-none block sm:hidden">
    <img
      src="/photos/NauticalDisaster.jpg"
      alt="ASV on Lake Ontario"
      class="w-full h-full object-cover scale-100"
    />
  </div>

  <!-- Overlay Content -->
  <div class="relative z-10 flex items-center justify-center h-full w-full bg-black/60 px-4 text-center">
    <div class="flex flex-col items-center">
      
      <!-- Logo and Name -->
      <h1 class="flex items-center gap-4 text-white text-4xl md:text-6xl font-normal leading-tight">
        <img
          src="/logos/WhiteTextLogo.svg"
          alt="aQuatonomous logo"
          class="w-16 h-16 md:w-20 md:h-20"
        />
        <div class="flex flex-col md:flex-row md:items-end">
          <span>
            <span class="font-extrabold text-white">aQua</span><span class="font-normal text-white">tonomous</span>
          </span>
          <span class="text-gray-400 text-sm md:text-base md:ml-2">
            @ Smith Engineering / Queen's University
          </span>
        </div>
      </h1>

      <!-- Tagline -->
      <h2 class="text-gray-400 text-base md:text-2xl font-normal leading-tight mt-2">
        Designing clean-powered Autonomous Surface Vehicles to empower ecological research.
      </h2>

      <!-- Scroll Down Icon -->
      <a href="#hero" class="mt-6 flex justify-center animate-bounce" aria-label="Scroll to content">
        <svg
          class="w-6 h-6 text-white opacity-70 hover:opacity-100 transition-opacity"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>

    </div>
  </div>
</div>
