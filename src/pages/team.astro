---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Sectionhead from "@components/SectionHead.astro";

// Try a different path pattern and log what we find
const images = import.meta.glob('../assets/**/*.{jpeg,jpg,png,gif}', {
  eager: true
});

// Log available images
console.log("Available images:", Object.keys(images));

const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// 2025–2026 ordering (new team)
const order2025_2026 = [
  "Omar Allam",
  "Julian Tiqui",
  "Grace Smerchinski",
  "Logan Calder",
  "Kate Aiken",
  "Sarah Dubé",
  "Ethan Astri",
  "Lorenzo DeMarni",
  "Jacob Badali",
  "Charles Debane",
  "Teema Mackay",
  "Julia Atteck",
  "Brian McRae",
  "Thomas Hung"
];

// 2024–2025 ordering (old team)
const order2024_2025 = [
  "Sabrina Button",
  "Will Palacek",
  "Julian Tiqui",
  "Logan Calder",
  "Aaron Kleiman",
  "Spencer Osborn",
  "Aedan Loughran",
  "Angus Dickson",
  "Sara Bacher",
  "Joshua Gonzales",
  "Jai Moraes"
];

// Helper to sort by an order array
const sortByOrder = (members, order) =>
  members.sort((a, b) => {
    const indexA = order.indexOf(a.data.name);
    const indexB = order.indexOf(b.data.name);
    return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
  });

const getTeamCardClass = (index, total) => {
  const remainder = total % 3;

  if (remainder === 1 && index === total - 1) {
    return "sm:col-start-3";
  }

  if (remainder === 2) {
    if (index === total - 2) {
      return "sm:col-start-2";
    }

    if (index === total - 1) {
      return "sm:col-start-4";
    }
  }

  return "";
};

// Split into two groups
const team2025_2026 = sortByOrder(
  publishedTeamMembers.filter((m) => {
    const imagePath = `../assets/team-2025-2026/${m.data.avatar.src}`;
    return order2025_2026.includes(m.data.name) && Boolean(images[imagePath]);
  }),
  order2025_2026
);

const team2024_2025 = sortByOrder(
  publishedTeamMembers.filter((m) => {
    const imagePath = `../assets/team-2024-2025/${m.data.avatar.src}`;
    return order2024_2025.includes(m.data.name) && Boolean(images[imagePath]);
  }),
  order2024_2025
);

// Log team member data
publishedTeamMembers.forEach(member => {
  console.log("Member image path:", member.data.avatar.src);
});
---
<Layout title="Our Team">
  <Container class="text-AquaNavy relative z-10">
    <Sectionhead>
      <Fragment slot="title">Our Team</Fragment>
      <Fragment slot="desc">
        Founded in 2023, aQuatonomous has rapidly expanded to a team of over 110+ active members
        dedicated to pushing the boundaries of autonomous maritime technology. Our mission is to
        design, build, and program a cutting-edge autonomous surface vehicle (ASV), offering students
        an unparalleled opportunity to gain hands-on experience with advanced autonomous systems
        and sustainable innovation.
      </Fragment>
      <Fragment slot="desc">
        <br /><br />
        <span class="text-gray-800 font-semibold">2025–2026 Team</span>
      </Fragment>
    </Sectionhead>

    {/* 2025–2026 Team – replaces the current grid */}
    <div class="grid grid-cols-1 gap-10 mx-auto max-w-5xl mt-12 sm:grid-cols-6">
      {
        team2025_2026.map((teamMemberEntry, index) => {
          const imagePath = `../assets/team-2025-2026/${teamMemberEntry.data.avatar.src}`;
          const image = images[imagePath];

          if (!image) {
            console.error(`Image not found for path: ${imagePath}`);
            return null;
          }

          return (
            <div class={`group sm:col-span-2 ${getTeamCardClass(index, team2025_2026.length)}`}>
              <div class="w-full aspect-square">
                <a href={teamMemberEntry.data.url}>
                  <Picture
                    src={image.default}
                    alt={teamMemberEntry.data.avatar.alt}
                    sizes="(max-width: 800px) 100vw, 400px"
                    width={400}
                    height={400}
                    class="w-full rounded-md rounded transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
                  />
                </a>
              </div>
              <div class="mt-4 text-center">
                <h2 class="text-lg text-gray-800">{teamMemberEntry.data.name}</h2>
                <h3 class="text-sm text-slate-500">
                  {teamMemberEntry.data.title}
                </h3>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* 2024–2025 Team – old team in dropdown below */}
    <details class="mt-16">
      <summary class="cursor-pointer text-lg font-semibold text-center">
        2024–2025 Team
      </summary>

      <div class="grid grid-cols-1 gap-10 mx-auto max-w-5xl mt-8 sm:grid-cols-6">
        {
          team2024_2025.map((teamMemberEntry, index) => {
            const imagePath = `../assets/team-2024-2025/${teamMemberEntry.data.avatar.src}`;
            const image = images[imagePath];

            if (!image) {
              console.error(`Image not found for path: ${imagePath}`);
              return null;
            }

            return (
              <div class={`group sm:col-span-2 ${getTeamCardClass(index, team2024_2025.length)}`}>
                <div class="w-full aspect-square">
                  <a href={teamMemberEntry.data.url}>
                    <Picture
                      src={image.default}
                      alt={teamMemberEntry.data.avatar.alt}
                      sizes="(max-width: 800px) 100vw, 400px"
                      width={400}
                      height={400}
                      class="w-full rounded-md rounded transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
                    />
                  </a>
                </div>
                <div class="mt-4 text-center">
                  <h2 class="text-lg text-gray-800">{teamMemberEntry.data.name}</h2>
                  <h3 class="text-sm text-slate-500">
                    {teamMemberEntry.data.title}
                  </h3>
                </div>
              </div>
            );
          })
        }
      </div>
    </details>
  </Container>
</Layout>
