---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Sectionhead from "@components/SectionHead.astro";

// Try a different path pattern and log what we find
const images = import.meta.glob('../assets/**/*.{jpeg,jpg,png,gif}', {
  eager: true
});

// Log available images
console.log("Available images:", Object.keys(images));

const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// 2025–2026 ordering (new team)
const order2025_2026 = [
  "Omar Allam",
  "Julian Tiqui",
  "Grace Smerchinski",
  "Logan Calder",
  "Kate Aiken",
  "Sarah Dubé",
  "Ethan Astri",
  "Lorenzo DeMarni",
  "Jacob Badali",
  "Charles Debane",
  "Teema Mackay",
  "Julia Atteck",
  "Brian McRae",
  "Thomas Hung"
];

// 2024–2025 ordering (old team)
const order2024_2025 = [
  "Sabrina Button",
  "Will Palacek",
  "Julian Tiqui",
  "Logan Calder",
  "Aaron Kleiman",
  "Spencer Osborn",
  "Aedan Loughran",
  "Angus Dickson",
  "Sara Bacher",
  "Joshua Gonzales",
  "Jai Moraes"
];

// Helper to sort by an order array
const sortByOrder = (members, order) =>
  members.sort((a, b) => {
    const indexA = order.indexOf(a.data.name);
    const indexB = order.indexOf(b.data.name);
    return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
  });

const getTeamCardClass = (index, total) => {
  const remainder = total % 3;

  if (remainder === 1 && index === total - 1) {
    return "sm:col-start-3";
  }

  if (remainder === 2) {
    if (index === total - 2) {
      return "sm:col-start-2";
    }

    if (index === total - 1) {
      return "sm:col-start-4";
    }
  }

  return "";
};

// Split into two groups
const team2025_2026 = sortByOrder(
  publishedTeamMembers.filter((m) => {
    const imagePath = `../assets/team-2025-2026/${m.data.avatar.src}`;
    return (
      m.data.year !== "2026-2027" &&
      order2025_2026.includes(m.data.name) &&
      Boolean(images[imagePath])
    );
  }),
  order2025_2026
);

const team2024_2025 = sortByOrder(
  publishedTeamMembers.filter((m) => {
    const imagePath = `../assets/team-2024-2025/${m.data.avatar.src}`;
    return (
      m.data.year !== "2026-2027" &&
      order2024_2025.includes(m.data.name) &&
      Boolean(images[imagePath])
    );
  }),
  order2024_2025
);

const members2026 = new Map(
  publishedTeamMembers
    .filter((member) => member.data.year === "2026-2027")
    .map((member) => [member.data.name, member])
);

const groups2026_2027 = [
  {
    heading: "",
    names: ["Spencer Osborn", "Angus Dickson"],
  },
  {
    heading: "Mechanical",
    names: ["Kyle Hermer", "Mathias Weeda"],
  },
  {
    heading: "Electrical",
    names: [
      "Sachin Khandelwal",
      "Dylan Jacob",
      "Autumn Heyerman",
      "Alisa Ruzhynsky",
    ],
  },
  {
    heading: "Software Team",
    names: [
      "Ethan Astri",
      "Nathaniel Felsky-Deelstra",
      "Evan Verikios",
      "Visakam Markilrajah",
    ],
  },
  {
    heading: "Ecological",
    names: ["Julie Schaber", "Kaya Novotny", "Jimmy Tia"],
  },
  {
    heading: "NAVIS",
    names: ["Carson Wong", "Becca Salai"],
  },
  {
    heading: "Business",
    names: ["Will Garrod", "Bryce Tovich", "Tecla Johnson"],
  },
].map((group) => ({
  heading: group.heading,
  members: group.names.flatMap((name) => {
    const member = members2026.get(name);
    return member ? [member] : [];
  }),
}));

// Log team member data
publishedTeamMembers.forEach(member => {
  console.log("Member image path:", member.data.avatar.src);
});
---
<Layout title="Our Team">
  <Container class="text-AquaNavy relative z-10">
    <Sectionhead>
      <Fragment slot="title">Our Team</Fragment>
      <Fragment slot="desc">
        Founded in 2023, aQuatonomous has rapidly expanded to a team of over 110+ active members
        dedicated to pushing the boundaries of autonomous maritime technology. Our mission is to
        design, build, and program a cutting-edge autonomous surface vehicle (ASV), offering students
        an unparalleled opportunity to gain hands-on experience with advanced autonomous systems
        and sustainable innovation.
      </Fragment>
      <Fragment slot="desc">
        <br /><br />
        <span class="text-gray-800 font-semibold">2026–2027 Team</span>
      </Fragment>
    </Sectionhead>

    {
      groups2026_2027.map((group) => (
        <section>
          {group.heading && (
            <h2 class="mt-16 text-center text-xl font-semibold text-gray-800">
              {group.heading}
            </h2>
          )}
          <div
            class="team-row mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-10"
            data-count={group.members.length}
            style={`--team-count: ${group.members.length};`}
          >
            {
              group.members.map((teamMemberEntry) => {
                const imagePath = `../assets/team-2026-2027/${teamMemberEntry.data.avatar.src}`;
                const image = images[imagePath];

                return (
                  <div class="group min-w-0">
                    <div class="w-full aspect-square">
                      {image ? (
                        <a
                          href={teamMemberEntry.data.url || undefined}
                          target={teamMemberEntry.data.url ? "_blank" : undefined}
                          rel={teamMemberEntry.data.url ? "noopener noreferrer" : undefined}
                        >
                          <Picture
                            src={image.default}
                            alt={teamMemberEntry.data.avatar.alt}
                            sizes="(max-width: 800px) 100vw, 400px"
                            width={400}
                            height={400}
                            class="w-full rounded-md transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
                          />
                        </a>
                      ) : teamMemberEntry.data.url ? (
                        <a
                          href={teamMemberEntry.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="block w-full h-full rounded-md bg-slate-100"
                          aria-label={teamMemberEntry.data.name}
                        ></a>
                      ) : (
                        <div class="w-full h-full rounded-md bg-slate-100"></div>
                      )}
                    </div>
                    <div class="mt-4 text-center">
                      <h2 class="text-lg text-gray-800">{teamMemberEntry.data.name}</h2>
                      <h3 class="text-sm text-slate-500">
                        {teamMemberEntry.data.title}
                      </h3>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </section>
      ))
    }

    {/* 2025–2026 Team */}
    <details class="mt-16">
      <summary class="cursor-pointer text-lg font-semibold text-center">
        2025–2026 Team
      </summary>

      <div class="grid grid-cols-1 gap-10 mx-auto max-w-5xl mt-8 sm:grid-cols-6">
        {
          team2025_2026.map((teamMemberEntry, index) => {
            const imagePath = `../assets/team-2025-2026/${teamMemberEntry.data.avatar.src}`;
            const image = images[imagePath];

            if (!image) {
              console.error(`Image not found for path: ${imagePath}`);
              return null;
            }

            return (
              <div class={`group sm:col-span-2 ${getTeamCardClass(index, team2025_2026.length)}`}>
                <div class="w-full aspect-square">
                  <a href={teamMemberEntry.data.url} target="_blank" rel="noopener noreferrer">
                    <Picture
                      src={image.default}
                      alt={teamMemberEntry.data.avatar.alt}
                      sizes="(max-width: 800px) 100vw, 400px"
                      width={400}
                      height={400}
                      class="w-full rounded-md rounded transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
                    />
                  </a>
                </div>
                <div class="mt-4 text-center">
                  <h2 class="text-lg text-gray-800">{teamMemberEntry.data.name}</h2>
                  <h3 class="text-sm text-slate-500">
                    {teamMemberEntry.data.title}
                  </h3>
                </div>
              </div>
            );
          })
        }
      </div>
    </details>

    {/* 2024–2025 Team – old team in dropdown below */}
    <details class="mt-16">
      <summary class="cursor-pointer text-lg font-semibold text-center">
        2024–2025 Team
      </summary>

      <div class="grid grid-cols-1 gap-10 mx-auto max-w-5xl mt-8 sm:grid-cols-6">
        {
          team2024_2025.map((teamMemberEntry, index) => {
            const imagePath = `../assets/team-2024-2025/${teamMemberEntry.data.avatar.src}`;
            const image = images[imagePath];

            if (!image) {
              console.error(`Image not found for path: ${imagePath}`);
              return null;
            }

            return (
              <div class={`group sm:col-span-2 ${getTeamCardClass(index, team2024_2025.length)}`}>
                <div class="w-full aspect-square">
                  <a href={teamMemberEntry.data.url} target="_blank" rel="noopener noreferrer">
                    <Picture
                      src={image.default}
                      alt={teamMemberEntry.data.avatar.alt}
                      sizes="(max-width: 800px) 100vw, 400px"
                      width={400}
                      height={400}
                      class="w-full rounded-md rounded transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
                    />
                  </a>
                </div>
                <div class="mt-4 text-center">
                  <h2 class="text-lg text-gray-800">{teamMemberEntry.data.name}</h2>
                  <h3 class="text-sm text-slate-500">
                    {teamMemberEntry.data.title}
                  </h3>
                </div>
              </div>
            );
          })
        }
      </div>
    </details>
  </Container>
</Layout>

<style>
  @media (min-width: 640px) {
    .team-row {
      grid-template-columns: repeat(var(--team-count), minmax(0, 1fr));
    }

    .team-row[data-count="1"] {
      grid-template-columns: minmax(0, calc((100% - 5rem) / 3));
      justify-content: center;
    }

    .team-row[data-count="2"] {
      grid-template-columns: repeat(2, minmax(0, calc((100% - 5rem) / 3)));
      justify-content: center;
    }
  }
</style>
