---
import Container from "@components/Container.astro";
import Sectionhead from "@components/SectionHead.astro";
import Layout from "@layouts/Layout.astro";
import { currentAchievements, latestAchievements } from "@utils/achievements.js";
---

<Layout title="Our Achievements">
  <Container class="relative z-10 text-AquaNavy">
    <Sectionhead>
      <Fragment slot="title">Our Achievements</Fragment>
      <Fragment slot="desc">
        A running record of aQuatonomous milestones, from our 2025 team awards
        to our most recent RoboBoat 2026 results.
      </Fragment>
    </Sectionhead>

    <section class="mt-10">
      <div class="rounded-xl border-2 border-dashed border-slate-300 bg-transparent p-8 md:p-10">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-AquaNavy">2026 Achievements</h2>
          <p class="mt-4 text-lg text-slate-600">
            Our newest competition results from RoboBoat 2026, including a podium
            finish and the top North American placement.
          </p>
        </div>

        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {latestAchievements.map((item) => (
            <article class="rounded-lg bg-transparent p-6">
              <div class="text-3xl" aria-hidden="true">{item.emoji}</div>
              <h3 class="mt-4 text-2xl font-semibold text-AquaNavy">{item.title}</h3>
              <p class="mt-3 text-lg leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-20 pb-8 md:pb-24">
      <div class="rounded-xl border-2 border-dashed border-slate-300 bg-transparent p-8 md:p-10">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-AquaNavy">2025 Achievements</h2>
          <p class="mt-4 text-lg text-slate-600">
            These milestones reflect the key achievements that defined our 2025
            season and the team's early growth.
          </p>
        </div>

        <div class="mt-10 grid gap-8 sm:grid-cols-2 md:grid-cols-3">
          {currentAchievements.map((item) => (
            <article class="flex items-start gap-4 rounded-lg bg-transparent p-5">
              <div class="text-2xl" aria-hidden="true">{item.emoji}</div>
              <div>
                <h3 class="text-lg font-semibold text-AquaNavy">{item.title}</h3>
                <p class="mt-2 leading-relaxed text-slate-500">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </Container>
</Layout>
